<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".IdeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.JavaIDE"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.FileExplorerActivity"
            android:exported="false"
            android:label="@string/title_file_explorer" />

        <activity
            android:name=".ui.EditorActivity"
            android:exported="false"
            android:label="@string/title_editor"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.BuildOutputActivity"
            android:exported="false"
            android:label="@string/title_build_output" />

        <activity
            android:name=".ui.LogcatActivity"
            android:exported="false"
            android:label="@string/title_logcat" />

        <activity
            android:name=".ui.ProjectSettingsActivity"
            android:exported="false"
            android:label="@string/title_project_settings" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/title_history" />

        <activity
            android:name=".ui.VersionControlActivity"
            android:exported="false"
            android:label="@string/title_version_control" />

        <activity
            android:name=".ui.PracticeActivity"
            android:exported="false"
            android:label="@string/title_practice" />

        <activity
            android:name=".ui.PracticeDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ProjectSearchActivity"
            android:exported="false"
            android:label="@string/title_find_in_project"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.HelpActivity"
            android:exported="false"
            android:label="@string/title_help" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
